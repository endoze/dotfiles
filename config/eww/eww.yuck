; Menu bar: Nix menu, active app, spaces on the left; tray, stats, clock on the right.
(include "./widgets/workspaces.yuck")
(include "./widgets/clock.yuck")
(include "./widgets/sysinfo.yuck")
(include "./widgets/volume-osd.yuck")
(include "./widgets/powermenu.yuck")

(deflisten activeapp :initial "Desktop"
  "~/.config/eww/scripts/activeapp.sh"
)

(defwidget tray []
  (box :class "tray" :orientation "h" :spacing 0
    (systray :icon-size 20 :orientation "h" :spacing 16)
  )
)

(defwidget left []
  (box :class "menubar-left" :orientation "h" :spacing 18 :space-evenly false
    (button :class "logo ${pm_open ? 'open' : ''}" :onclick "eww open --toggle powermenu && eww update pm_open=$(eww active-windows | grep -q '^powermenu:' && echo true || echo false)" (label :text ""))
    (label :class "appname" :text activeapp :xalign 0 :limit-width 18)
    (workspaces)
  )
)

(defwidget right []
  (box :class "menubar-right" :orientation "h" :spacing 18 :space-evenly false
    (tray)
    (sysinfo)
    (clock)
  )
)

(defwidget bar []
  (centerbox :orientation "h" :class "menubar"
    (box :halign "start" (left))
    (box :halign "center" :hexpand false)
    (box :halign "end" (right))
  )
)

(defwindow bar
  :monitor 0
  :geometry (geometry
    :x "0%"
    :y "0px"
    :width "100%"
    :height "38px"
    :anchor "top center"
  )
  :stacking "fg"
  :exclusive true
  :namespace "eww-bar"
  (bar)
)
