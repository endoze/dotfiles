; Menu bar clock: "Sat Oct 3  9:05 AM"
(defpoll time_val :interval "5s" "date '+%-I:%M %p'")
(defpoll date_val :interval "60s" "date '+%a %b %-d'")

(defwidget clock []
  (box :class "clock" :orientation "h" :spacing 10 :space-evenly false
    (label :class "clock-date" :text date_val)
    (label :class "clock-time" :text time_val)
  )
)
