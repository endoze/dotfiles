; Monochrome status glyphs
(defpoll cpu :interval "3s" "~/.config/eww/scripts/sysinfo.sh cpu")
(defpoll memory :interval "3s" "~/.config/eww/scripts/sysinfo.sh memory")
(defpoll volume :interval "1s" "~/.config/eww/scripts/volume.sh")

(defwidget sysinfo []
  (box :class "sysinfo" :orientation "h" :spacing 18 :space-evenly false
    (box :class "stat" :orientation "h" :spacing 5
      (label :class "glyph" :text "󰍛")
      (label :text "${cpu}%")
    )
    (box :class "stat" :orientation "h" :spacing 5
      (label :class "glyph" :text "󰘚")
      (label :text "${memory}%")
    )
    (button :class "stat vol ${vol_osd_open ? 'active' : ''}" :onclick "~/.config/eww/scripts/volume-osd.sh mute"
      (label :class "glyph" :text {replace(volume, "\\s.*$", "")})
    )
    (button :class "stat notif-btn"
      :onclick "busctl --user call org.freedesktop.shirase.Control /org/freedesktop/shirase/Control org.freedesktop.shirase.Control ToggleCenter"
      :tooltip "Notifications"
      (label :class "glyph" :text "󰨚")
    )
  )
)
